APP_ENV=production
DATABASE_URL=postgresql+psycopg://ivory_booking:CHANGE_DATABASE_PASSWORD@postgres:5432/ivory_booking
REDIS_URL=redis://redis:6379/0

# Generate with: openssl rand -hex 32
SESSION_PEPPER=CHANGE_TO_64_RANDOM_HEX_CHARACTERS

# Generate with: python3 scripts/generate-secrets.py
FIELD_ENCRYPTION_KEY=CHANGE_TO_A_FERNET_KEY

PLATFORM_ADMIN_EMAIL=mark@perfectweddingsbymark.uk
PLATFORM_ADMIN_NAME=Mark Powell
PLATFORM_ADMIN_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD

MANAGER_URL=https://manager.ivorydigital.uk
STUDIO_URL=https://studio.ivorydigital.uk
CLIENT_URL=https://client.ivorydigital.uk
COOKIE_SECURE=true
TRIAL_DAYS=30
SESSION_HOURS=12
INVITATION_HOURS=72

PLATFORM_STORAGE_ROOT=/app/platform-storage
TENANT_STORAGE_ROOT=/app/tenant-data

# One Ivory Digital Google Cloud OAuth app; every studio connects its own
# Google account and chooses its own calendar. Leave blank until configured.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://studio.ivorydigital.uk/api/integrations/google-calendar/callback

# Browser-restricted key used only by public enquiry forms. Enable Maps
# JavaScript API and Places API (New), then restrict website access to:
# https://client.ivorydigital.uk/*
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_PLACES_REGION_CODES=gb

POSTGRES_DB=ivory_booking
POSTGRES_USER=ivory_booking
POSTGRES_PASSWORD=CHANGE_DATABASE_PASSWORD
